# ─── Mode Selection ───────────────────────────────────────────────────────────
# Set STORAGE_EMULATOR_MODE=true for local development (no GCP billing needed)
# Set STORAGE_EMULATOR_MODE=false for real Google Cloud Storage

# ─── Emulator Mode (fake-gcs-server) ─────────────────────────────────────────
GCS_BUCKET_NAME=cloudvault-demo
GOOGLE_CLOUD_PROJECT=cloudvault-local
STORAGE_EMULATOR_HOST=http://localhost:4443
STORAGE_EMULATOR_MODE=true
PORT=5000
FLASK_DEBUG=1
ALLOWED_ORIGINS=http://localhost:3000

# ─── Production Mode ─────────────────────────────────────────────────────────
# GCS_BUCKET_NAME=your-real-bucket-name
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# STORAGE_EMULATOR_HOST=
# STORAGE_EMULATOR_MODE=false
# PORT=5000
# FLASK_DEBUG=0
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
